# QUICK Guard configuration
# Copy this file to .env and fill in your own values:   cp .env.example .env
# NEVER commit .env. Each teammate uses their own PayPal sandbox keys.

# ── PayPal (sandbox only) ─────────────────────────────────────────
# Get these at https://developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_MODE=sandbox

# ── AI provider ───────────────────────────────────────────────────
# ollama = local Llama 3 on your laptop (needs Ollama running)
# groq   = hosted Llama 3 API (used for the deployed demo)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
GROQ_API_KEY=your-groq-api-key

# ── Local-only power tools ────────────────────────────────────────
# Code runner, website/port scanner, PCAP analysis, file uploads,
# OSINT lookups, monitoring, mic voice mode, and settings changes.
# Keep false on any public server.
ENABLE_QUICK_TOOLS=false

# ── Optional API keys for local QUICK tools (leave blank if unused) ──
BRAVE_API_KEY=
GITHUB_TOKEN=
HIBP_API_KEY=
VIRUSTOTAL_API_KEY=
NUMVERIFY_API_KEY=
ABSTRACT_PHONE_API_KEY=
